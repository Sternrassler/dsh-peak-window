{
  "name": "@sternrassler/dsh-peak-window",
  "version": "1.0.0",
  "type": "module",
  "description": "Shows the current DeepSeek price window (PEAK/OFF_PEAK) with a countdown in the DSH status line below the composer.",
  "keywords": [
    "dsh",
    "deepseek",
    "plugin",
    "pricing",
    "peak",
    "countdown"
  ],
  "license": "MIT",
  "author": {
    "name": "sternrassler",
    "url": "https://github.com/Sternrassler"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sternrassler/dsh-peak-window.git",
    "directory": "."
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "data",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "check:links": "node scripts/check-links.mjs",
    "test": "node --test test/*.test.js",
    "check": "npm run check:client && npm run lint && npm run format:check && npm test",
    "prepublishOnly": "npm run check",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "secret": "gitleaks detect --no-banner --redact --exit-code 1 --gitleaks-ignore-path .gitleaksignore",
    "sast": "semgrep scan --config p/ci --error --severity ERROR",
    "deps": "npm audit --omit=dev --audit-level=high"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "prettier": "^3.9.10"
  }
}
